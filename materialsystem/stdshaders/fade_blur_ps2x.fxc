sampler g_sBase	: register( s0 );

float3 g_vColorFade : register( c0 );

struct PS_INPUT
{
	float2 uv : TEXCOORD0;
};

float4 main( PS_INPUT i ) : COLOR0
{
	// Fetch blurred texel
	float4 o = tex2D( g_sBase, i.uv );

	// Color fade
	o.rgb *= g_vColorFade.rgb;

	// Set alpha blend value
	o.a = 1.0f;

	return o;
}
